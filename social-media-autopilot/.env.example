# === Identidade do negócio (personaliza os textos gerados) ===
NICHO=marketing digital
NOME_PRODUTO=o meu produto digital
PALAVRA_CHAVE_CTA=QUERO
LINK_BIO=https://linktr.ee/o-teu-link

# === Email diário com a publicação pronta a copiar ===
EMAIL_DESTINO=o-teu-email@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=o-teu-email@gmail.com
# App Password do Gmail: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=

# === IA (opcional, recomendado) ===
# Sem isto, o sistema usa um banco de fórmulas de copywriting testadas.
# Com isto, os ganchos/legendas são personalizados ao tema exacto de cada vídeo.
ANTHROPIC_API_KEY=

# === Publicação automática (opcional/avançado — precisa de apps aprovadas) ===
AUTO_PUBLICAR=false

# Instagram Graph API (conta Business/Creator ligada a uma Página do Facebook)
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
# URL público onde os vídeos ficam alojados (obrigatório para a API do Instagram)
VIDEO_PUBLIC_BASE_URL=

# TikTok Content Posting API (app aprovada com scope video.publish)
TIKTOK_ACCESS_TOKEN=
# SELF_ONLY funciona sem auditoria do TikTok; PUBLIC_TO_EVERYONE requer app auditada
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
