# Google Maps API Key
# Obter em: https://console.cloud.google.com/apis/library/places-backend.googleapis.com
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Email de destino
EMAIL_DESTINO=ai.businessportugal@gmail.com

# Configuração SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ai.businessportugal@gmail.com
# App Password do Gmail: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your_gmail_app_password_here

# Regiões a pesquisar (separadas por vírgula)
